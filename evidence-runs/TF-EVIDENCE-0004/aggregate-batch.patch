@@ -1,7 +1,10 @@
 export async function getInvoice(req, res, db) {
   const { invoiceId } = req.params;
-  // Retrieve invoice details by identifier
+  const currentTenantId = req.user.tenantId;
+
   const invoice = await db.invoices.findById(invoiceId);
