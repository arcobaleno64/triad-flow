+// Cluster C07: Truncated Callee Body Context Gap & Verifier UNCERTAIN (rsKCC, slLWi)
+// ============================================================================
+
+test("SYSTEMIC-C07-TRUNCATED-CALLEE-GAP: Emits CALLEE_TRUNCATED_ELIDED gap for oversized sensitive callee", () => {
+  const largeFn = [
+    "function validateUserCredentials(user) {",
+    ...Array.from({ length: 45 }, (_, i) => `  if (user.step${i}) return false;`),
+    "  return true;",
+    "}"
+  ].join("\n");
+
+  const diffHunks = [
+    "@@ -1,3 +1,4 @@",
+    " function handle() {",
+    "+  validateUserCredentials(currentUser);",
+    " }"
+  ].join("\n");
+
+  const res = extractLocalCalleeContext(largeFn, diffHunks, "src/auth.mjs");
+  assert.equal(res.callees.length, 1);
+  assert.notEqual(res.callees[0].extractionMode, "full_body", "Oversized function must not have full_body extractionMode");
+
+  const gap = res.contextGaps.find(g => g.reason === "CALLEE_TRUNCATED_ELIDED");
+  assert.ok(gap, "Must emit CALLEE_TRUNCATED_ELIDED contextGap for truncated sensitive callee");
+  assert.equal(gap.symbol, "validateUserCredentials");
+  assert.equal(gap.category, "input_validation");
+});
+
+test("SYSTEMIC-C07-TRUNCATED-CALLEE-GAP (Cross-layer): CALLEE_TRUNCATED_ELIDED gap forces Gate to block Clean Approval", () => {
+  const consensus = aggregateConsensus({
+    agy: { provider: "agy", executionStatus: "success", fileCoverageComplete: true, findings: [{ ruleId: "TEST-1", severity: "medium", title: "Test finding" }] },
+    claude: { provider: "claude", executionStatus: "success", fileCoverageComplete: true, findings: [{ ruleId: "TEST-1", severity: "medium", title: "Test finding" }] },
+    codex: { provider: "codex", executionStatus: "success", fileCoverageComplete: true, findings: [{ ruleId: "TEST-1", severity: "medium", title: "Test finding" }] }
+  }, { policy: "TRI_PARTY_HETEROGENEOUS", tier: 1 });
+
+  const gate = evaluateGateDecision(consensus, {
+    tier: 1,
+    strict: true,
+    contextGaps: [
+      {
+        symbol: "validateUserCredentials",
+        reason: "CALLEE_TRUNCATED_ELIDED",
+        category: "security",
+        impact: "Truncated sensitive callee"
+      }
+    ]
+  });
+
+  assert.equal(gate.decision, "block", "Unresolved security/sensitive context gap must block gate decision");
+  assert.ok(gate.reason.includes("context gap") || gate.reason.includes("CALLEE_TRUNCATED_ELIDED"));
+});
+
