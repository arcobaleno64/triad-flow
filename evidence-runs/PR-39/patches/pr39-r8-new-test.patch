+test("SYSTEMIC-C04-ACCESS-CONTROL-VOCAB: Policy, enforce, rbac, acl, and permission terms classify as security", () => {
+  const terms = ["policyCheck", "enforceAccess", "rbacRole", "aclVerifier", "hasPermission", "canAccess"];
+  for (const t of terms) {
+    const cat = classifySensitiveCategory(t);
+    assert.equal(cat, "security", `Term '${t}' must be classified as 'security', got '${cat}'`);
+  }
+});
+
+test("SYSTEMIC-C04-ACCESS-CONTROL-VOCAB: Receiver classification for policy.enforce() and acl.canAccess()", () => {
+  const diffHunks = [
+    "@@ -10,3 +10,4 @@",
+    " function check(ctx) {",
+    "+  policy.enforce(ctx.user);",
+    "+  acl.canAccess(ctx.resource);",
+    " }"
+  ].join("\n");
+
+  const candidates = extractCandidateCallSymbols(diffHunks);
+  assert.equal(candidates.length, 2);
+  const enforceCall = candidates.find(c => c.symbol === "enforce");
+  assert.ok(enforceCall, "Should extract enforce");
+  assert.equal(enforceCall.isSensitive, true);
+  assert.equal(enforceCall.category, "security");
+
+  const aclCall = candidates.find(c => c.symbol === "canAccess");
+  assert.ok(aclCall, "Should extract canAccess");
+  assert.equal(aclCall.isSensitive, true);
+  assert.equal(aclCall.category, "security");
+});
