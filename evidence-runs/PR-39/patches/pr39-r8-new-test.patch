+test("SYSTEMIC-C14A-FORGED-CALLEE-REJECTION (Negative): Rejects external ContextPackage containing callee not present in exact-head commit", async () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "c14a-test-"));
+  try {
+    execFileSync("git", ["init"], { cwd: tmpDir, stdio: "ignore" });
+    execFileSync("git", ["config", "user.name", "Test"], { cwd: tmpDir, stdio: "ignore" });
+    execFileSync("git", ["config", "user.email", "test@test.com"], { cwd: tmpDir, stdio: "ignore" });
+
+    const testFile = path.join(tmpDir, "src", "service.mjs");
+    fs.mkdirSync(path.dirname(testFile), { recursive: true });
+    fs.writeFileSync(testFile, "export function realFunction() { return 1; }\n");
+    execFileSync("git", ["add", "."], { cwd: tmpDir, stdio: "ignore" });
+    execFileSync("git", ["commit", "-m", "init"], { cwd: tmpDir, stdio: "ignore" });
+    const headSha = execFileSync("git", ["rev-parse", "HEAD"], { cwd: tmpDir, encoding: "utf8" }).trim();
+
+    const diffHunks = "@@ -1 +1 @@\n+const x = 1;\n";
+    const contentDigest = crypto.createHash("sha256").update(diffHunks, "utf8").digest("hex");
+    const sourceDigest = crypto.createHash("sha256").update("export function realFunction() { return 1; }\n", "utf8").digest("hex");
+
+    // 1. Structure baseline: verify that a valid package passes all structure and Git source checks (F-R4-02)
+    const validBaselinePkg = {
+      ok: true,
+      schemaVersion: "2.0.0",
+      headSha,
+      repositoryRoot: tmpDir,
+      targetFile: "src/service.mjs",
+      contentDigest,
+      budgetAccounting: {
+        totalBudgetBytes: 8192,
+        consumedBytes: 500,
+        remainingBytes: 7692,
+        retainedCalleesCount: 1,
+        evictedCalleesCount: 0,
+        evictedCallees: []
+      },
+      fileCoverageManifest: [
+        {
+          file: "src/service.mjs",
+          inspected: true,
+          exactHeadAvailable: true,
+          sourceDigest,
+          calleesExtracted: ["realFunction"]
+        }
+      ],
+      layers: {
+        layer0Diff: { rawHunks: diffHunks },
+        layer1AstEnclosure: {
+          callees: [
+            {
+              symbol: "realFunction",
+              file: "src/service.mjs",
+              definition: "export function realFunction() { return 1; }"
+            }
+          ]
+        }
+      }
+    };
+
+    const validCheck = validateContextPackageAuthenticity(validBaselinePkg, {
+      repositoryRoot: tmpDir,
+      headSha,
+      diffHunks
+    });
+    assert.equal(validCheck, true, "Authentic package with genuine exact-head callee must pass structural and authenticity validation");
+
+    // 2. Forged package: same structure, but contains forged callee not present in exact-head git commit
+    const forgedPkg = {
+      ...validBaselinePkg,
+      layers: {
+        layer0Diff: { rawHunks: diffHunks },
+        layer1AstEnclosure: {
+          callees: [
+            {
+              symbol: "forgedFunction",
+              file: "src/service.mjs",
+              definition: "function forgedFunction() { doMaliciousThings(); }"
+            }
+          ]
+        }
+      }
+    };
+
+    // Prove that forgedPkg fails authenticity strictly at the Git source comparison step
+    const forgedCheck = validateContextPackageAuthenticity(forgedPkg, {
+      repositoryRoot: tmpDir,
+      headSha,
+      diffHunks
+    });
+    assert.equal(forgedCheck, false, "Forged callee must fail authenticity solely at the physical Git HEAD callee verification step");
+
+    const changeSet = {
+      headSha,
+      files: [{ path: "src/service.mjs" }],
+      diffHunks
+    };
+
+    const runContext = new RunContext({
+      runId: crypto.randomUUID(),
+      headSha,
+      contentDigest: "aaaa",
+      patchObjective: "test"
+    });
+
+    let verifierPromptCaptured = "";
+    const mockVerifier = {
+      providerName: "claude",
+      modelName: "claude-5.5-sonnet",
+      executeVerification: async (input) => {
+        verifierPromptCaptured = JSON.stringify(input);
+        return {
+          rawOutput: JSON.stringify({ verdict: "APPROVE", overallStatus: "CONFIRMED" }),
+          executionStatus: "success"
+        };
+      }
+    };
+
+    const res = await conductIndependentVerification(
+      changeSet,
+      [],
+      mockVerifier,
+      {
+        verificationMode: "clean_challenge",
+        headSha,
+        repositoryRoot: tmpDir,
+        contextPackage: forgedPkg,
+        runContext
+      }
+    );
+
+    assert.ok(!verifierPromptCaptured.includes("forgedFunction"), "Verifier prompt must not contain unauthenticated forged callee");
+    const gap = res.contextGaps?.find(g => g.code === "EXACT_HEAD_CONTEXT_FAILED");
+    assert.ok(gap, "Forged context package must trigger EXACT_HEAD_CONTEXT_FAILED gap");
+  } finally {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  }
+});
