+// Cluster C02: Commented-Out Function Definitions Exclusion (rvCBT)
+// ============================================================================
+
+test("SYSTEMIC-C02-COMMENTED-DEF-EXCLUSION (Negative): Commented-out function definitions in /* */ are strictly excluded", () => {
+  const lines = [
