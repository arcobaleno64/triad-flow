+test("SYSTEMIC-C09-PATCH-ADDED-IMPORTS (Negative): Local definition deleted by patch is not treated as valid HEAD callee", () => {
+  const headContent = [
+    "function validateAccess(user) {",
+    "  return user.oldAccess;",
+    "}",
+    "export function run(user) {",
+    "  return validateAccess(user);",
