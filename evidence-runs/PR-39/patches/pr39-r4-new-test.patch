+  const diffHunks = [
+    "@@ -1,3 +1,4 @@",
+    " function handle() {",
+    "+  validateUserCredentials(currentUser);",
+    " }"
+  ].join("\n");
+
+  const res = extractLocalCalleeContext(smallFn, diffHunks, "src/auth.mjs");
+  assert.equal(res.callees.length, 1);
+  assert.equal(res.callees[0].extractionMode, "full_body");
+  const elidedGap = res.contextGaps.find(g => g.reason === "CALLEE_TRUNCATED_ELIDED");
+  assert.equal(elidedGap, undefined, "Full body snippet must not produce CALLEE_TRUNCATED_ELIDED gap");
+});
