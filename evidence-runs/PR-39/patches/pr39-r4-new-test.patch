+// ============================================================================
+// Cluster C14B: Registration Failure Workflow Authority Denial (rxCha)
+// ============================================================================
+
+test("SYSTEMIC-C14B-REGISTRATION-FAILURE-WORKFLOW-DENIAL (Negative): Failed context package registration denies workflow authority and causes Dogfood caller fail-closed", async () => {
+  const forgedPkg = {
+    headSha: "0000000000000000000000000000000000000000",
+    targetFile: "src/fake.mjs"
+  };
+
+  const regResult = registerTrustedContextPackage(forgedPkg, {
+    repositoryRoot: "/invalid/path/that/does/not/exist",
+    headSha: "0000000000000000000000000000000000000000",
+    verifiedBy: "dogfood-review"
+  });
+
+  assert.equal(regResult, null, "Registration with non-existent repository must return null");
+  assert.equal(isTrustedContextPackage(forgedPkg), false, "Forged package must not acquire trusted registration status");
+  assert.equal(forgedPkg.workflowAuthority, undefined, "Unverified package must not acquire workflowAuthority");
+
+  // Verify Dogfood caller behavior when registration returns null (F-R3-01)
+  const { runDogfoodReview } = await import("../scripts/dogfood-review.mjs");
+  const currentHead = execFileSync("git", ["rev-parse", "HEAD"], { encoding: "utf8" }).trim();
+  const tmpOut = path.join(os.tmpdir(), `dogfood-c14b-${Date.now()}.json`);
+  try {
+    const report = await runDogfoodReview({
+      mock: true,
+      head: currentHead,
+      changeSet: {
+        ok: true,
+        schemaVersion: "1.0.0",
+        headSha: currentHead,
+        commitSha: currentHead,
+        files: [{ path: "src/fake-nonexistent.mjs" }],
+        diffHunks: "@@ -1 +1 @@\n+const x = 1;"
+      },
+      contextPackage: {
+        headSha: currentHead,
+        targetFile: "src/fake-nonexistent.mjs",
+        fileCoverageManifest: [
+          { file: "src/fake-nonexistent.mjs", exactHeadAvailable: true }
+        ],
+        layers: {
+          layer1AstEnclosure: {
+            callees: [{ symbol: "fakeNonExistentCallee", file: "src/fake-nonexistent.mjs", definition: "function fakeNonExistentCallee() {}" }]
+          }
+        }
+      },
+      out: tmpOut,
+      log: false
+    });
+
+    assert.notEqual(report.gate?.decision, "approve", "Unverified contextPackage in Dogfood review must NOT receive Clean Approval");
+    assert.notEqual(report.advisoryGate?.decision, "approve", "Advisory gate must NOT approve when contextPackage registration fails");
+    const exactHeadGap = report.verificationRecord?.contextGaps?.find(g => g.code === "EXACT_HEAD_CONTEXT_FAILED");
+    assert.ok(exactHeadGap, "Dogfood review verificationRecord must contain EXACT_HEAD_CONTEXT_FAILED context gap when registration fails");
+  } finally {
+    if (fs.existsSync(tmpOut)) fs.unlinkSync(tmpOut);
+  }
+});
