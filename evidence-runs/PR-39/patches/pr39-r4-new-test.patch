+// ============================================================================
+// Cluster C12: Single-File Diff Isolation and Schema v2 Routing (rrHOc, rvWjO)
+// ============================================================================
+
+test("SYSTEMIC-C12-SINGLE-FILE-DIFF-ISOLATION: Multi-file diff is strictly isolated in single-file mode", () => {
+  const changeSet = {
+    headSha: "1111111111111111111111111111111111111111",
+    files: [
+      { path: "src/a.mjs", additions: 1, deletions: 0 },
+      { path: "src/b.mjs", additions: 1, deletions: 0 }
+    ],
+    diffHunks: [
+      "diff --git a/src/a.mjs b/src/a.mjs",
+      "--- a/src/a.mjs",
+      "+++ b/src/a.mjs",
+      "@@ -1,3 +1,4 @@",
+      " function a() {",
+      "+  callA();",
+      " }",
+      "diff --git a/src/b.mjs b/src/b.mjs",
+      "--- a/src/b.mjs",
+      "+++ b/src/b.mjs",
+      "@@ -1,3 +1,4 @@",
+      " function b() {",
+      "+  callB();",
+      " }"
+    ].join("\n")
+  };
+
+  const singlePkg = buildContextPackage(changeSet, "src/a.mjs", {
+    fileContents: {
+      "src/a.mjs": "function a() { return true; }"
+    }
+  });
+
+  assert.equal(singlePkg.targetFile, "src/a.mjs");
+  const rawHunks = singlePkg.layers?.layer0Diff?.rawHunks || "";
+  assert.ok(rawHunks.includes("callA()"), "Isolated diff for src/a.mjs must contain callA");
+  assert.ok(!rawHunks.includes("callB()"), "Isolated diff for src/a.mjs must NOT contain callB from src/b.mjs");
+});
+
