+// ============================================================================
+// Cluster C13: CLI Missing Repository Root Fail-Closed (tdsmP)
+// ============================================================================
+
+test("SYSTEMIC-C13-CLI-NO-REPO-FAIL-CLOSED (Negative): CLI Clean Challenge without reliable repository root fails closed with EXACT_HEAD_CONTEXT_FAILED", async () => {
+  const io = {
+    stdout: { write: () => {} },
+    stderr: { write: () => {} }
+  };
+
+  const tmpNonGit = fs.mkdtempSync(path.join(os.tmpdir(), "c13-non-git-"));
+  try {
+    const changeSet = {
+      ok: true,
+      headSha: "3333333333333333333333333333333333333333",
+      files: [{ path: "src/auth.mjs" }],
+      diffHunks: "@@ -1 +1 @@\n+const x = 1;"
+    };
+
+    const mockAdapters = {
+      macro: {
+        providerName: "agy",
+        modelName: "gemini-3.8-flash",
+        executeReview: async () => ({ findings: [], usage: { promptTokens: 10, completionTokens: 10, totalTokens: 20 } })
+      },
+      micro: {
+        providerName: "claude",
+        modelName: "claude-5.5-sonnet",
+        executeReview: async () => ({ findings: [], usage: { promptTokens: 10, completionTokens: 10, totalTokens: 20 } })
+      }
+    };
+
+    const exitCode = await runCli([
+      "review",
+      "--verify-with=claude"
+    ], io, {
+      getChangeSet: () => changeSet,
+      repoRoot: tmpNonGit,
+      cwd: tmpNonGit,
+      reviewAdapters: mockAdapters,
+      verifierExecFn: async () => ({ stdout: JSON.stringify({ verdict: "APPROVE", overallStatus: "CLEAN" }) }),
+      strict: true
+    });
+
+    assert.equal(exitCode, EXIT_CODES.GATE_BLOCKED, "Invalid repository root in Clean Challenge must block gate and exit GATE_BLOCKED");
+
+    // Also assert missing (null) targetRepo fails closed
+    const exitCodeNullRepo = await runCli([
+      "review",
+      "--verify-with=claude"
+    ], io, {
+      getChangeSet: () => changeSet,
+      repoRoot: null,
+      cwd: null,
+      reviewAdapters: mockAdapters,
+      verifierExecFn: async () => ({ stdout: JSON.stringify({ verdict: "APPROVE", overallStatus: "CLEAN" }) }),
+      strict: true
+    });
+
+    assert.equal(exitCodeNullRepo, EXIT_CODES.GATE_BLOCKED, "Missing (null) repository root in Clean Challenge must block gate and exit GATE_BLOCKED");
+
+    // Also assert completely omitted repository root fails closed (F-R3-03)
+    const exitCodeOmittedRepo = await runCli([
+      "review",
+      "--verify-with=claude"
+    ], io, {
+      getChangeSet: () => changeSet,
+      reviewAdapters: mockAdapters,
+      verifierExecFn: async () => ({ stdout: JSON.stringify({ verdict: "APPROVE", overallStatus: "CLEAN" }) }),
+      strict: true
+    });
+
+    assert.equal(exitCodeOmittedRepo, EXIT_CODES.GATE_BLOCKED, "Completely omitted repository root in Clean Challenge must block gate and exit GATE_BLOCKED");
