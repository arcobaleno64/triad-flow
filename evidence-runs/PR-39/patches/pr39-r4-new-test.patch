+// ============================================================================
+// Cluster C06: Built-in Methods on Sensitive Receivers (rr-I6, r1BuC)
+// ============================================================================
+
+test("SYSTEMIC-C06-BUILTIN-ON-SENSITIVE-RECEIVER: Retains sensitive receiver with builtin method name at both sites", () => {
+  const diffHunks = [
+    "@@ -5,4 +5,6 @@",
+    " function auth(user) {",
+    "+  permissions.has(user);",
+    "+  roles.has(",
+    "+    user.role",
+    "+  );",
+    " }"
+  ].join("\n");
+
+  const candidates = extractCandidateCallSymbols(diffHunks);
+  const permHas = candidates.find(c => c.symbol === "has" && (c.qualifier === "permissions" || c.qualifiers?.includes("permissions")));
+  assert.ok(permHas, "permissions.has must be retained because receiver is sensitive");
+  assert.equal(permHas.isSensitive, true);
+  assert.equal(permHas.category, "security");
+
+  const roleHas = candidates.find(c => c.symbol === "has" && (c.qualifier === "roles" || c.qualifiers?.includes("roles")));
+  assert.ok(roleHas, "roles.has must be retained because receiver is sensitive");
+  assert.equal(roleHas.isSensitive, true);
+  assert.equal(roleHas.category, "security");
+});
