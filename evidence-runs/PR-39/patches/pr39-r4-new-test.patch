+// ============================================================================
+// Cluster C14A: Dogfood Callee Authenticity & Verification (tdsmT)
+// ============================================================================
+
+test("SYSTEMIC-C14A-FORGED-CALLEE-REJECTION (Negative): Rejects external ContextPackage containing callee not present in exact-head commit", async () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "c14a-test-"));
+  try {
+    execFileSync("git", ["init"], { cwd: tmpDir, stdio: "ignore" });
+    execFileSync("git", ["config", "user.name", "Test"], { cwd: tmpDir, stdio: "ignore" });
+    execFileSync("git", ["config", "user.email", "test@test.com"], { cwd: tmpDir, stdio: "ignore" });
+
+    const testFile = path.join(tmpDir, "src", "service.mjs");
+    fs.mkdirSync(path.dirname(testFile), { recursive: true });
+    fs.writeFileSync(testFile, "export function realFunction() { return 1; }\n");
+    execFileSync("git", ["add", "."], { cwd: tmpDir, stdio: "ignore" });
+    execFileSync("git", ["commit", "-m", "init"], { cwd: tmpDir, stdio: "ignore" });
+    const headSha = execFileSync("git", ["rev-parse", "HEAD"], { cwd: tmpDir, encoding: "utf8" }).trim();
+
+    const forgedPkg = {
+      ok: true,
+      schemaVersion: "2.0.0",
+      headSha,
+      targetFile: "src/service.mjs",
+      contentDigest: crypto.createHash("sha256").update("@@ -1 +1 @@\n+const x = 1;\n").digest("hex"),
+      budgetAccounting: {
+        totalBudgetBytes: 8192,
+        consumedBytes: 500,
+        remainingBytes: 7692,
+        retainedCalleesCount: 1,
+        evictedCalleesCount: 0,
+        evictedCallees: []
+      },
+      fileCoverageManifest: [
+        {
+          file: "src/service.mjs",
+          exactHeadAvailable: true,
+          sourceDigest: crypto.createHash("sha256").update("export function realFunction() { return 1; }\n").digest("hex")
+        }
+      ],
+      layers: {
+        layer0Diff: { rawHunks: "@@ -1 +1 @@\n+const x = 1;" },
+        layer1AstEnclosure: {
+          callees: [
+            {
+              symbol: "forgedFunction",
+              file: "src/service.mjs",
+              definition: "function forgedFunction() { doMaliciousThings(); }"
+            }
+          ]
+        }
+      }
+    };
+
+    const changeSet = {
+      headSha,
+      files: [{ path: "src/service.mjs" }],
+      diffHunks: "@@ -1 +1 @@\n+const x = 1;"
+    };
+
+    const runContext = new RunContext({
+      runId: crypto.randomUUID(),
+      headSha,
+      contentDigest: "aaaa",
+      patchObjective: "test"
+    });
+
+    const mockVerifier = {
+      providerName: "claude",
+      modelName: "claude-5.5-sonnet",
+      executeVerification: async (prompt) => {
+        assert.ok(!prompt.includes("forgedFunction"), "Prompt must not include unauthenticated forged callee");
+        return {
+          rawOutput: JSON.stringify({ verdict: "APPROVE", overallStatus: "CONFIRMED" }),
+          executionStatus: "success"
+        };
+      }
+    };
+
+    const res = await conductIndependentVerification(
+      changeSet,
+      [],
+      mockVerifier,
+      {
+        verificationMode: "clean_challenge",
+        headSha,
+        repositoryRoot: tmpDir,
+        contextPackage: forgedPkg,
+        runContext
+      }
+    );
+
+    const gap = res.contextGaps?.find(g => g.code === "EXACT_HEAD_CONTEXT_FAILED");
+    assert.ok(gap, "Forged context package must trigger EXACT_HEAD_CONTEXT_FAILED gap");
+  } finally {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  }
+});
