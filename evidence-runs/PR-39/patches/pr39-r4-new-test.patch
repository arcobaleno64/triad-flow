+// ============================================================================
+// Cluster C01: Hunk Lexical State (rte6z, slAMv)
+// ============================================================================
+
+test("SYSTEMIC-C01-HUNK-LEXICAL-STATE (Negative): Hunk starting inside block comment ignores commented code when fileContent is provided", () => {
+  const fileContent = [
+    "/*",
+    " * Multiline block comment starting at line 1",
+    " * continuing to line 149...",
+    " */",
+    "function realCode() {",
+    "  return 42;",
+    "}"
+  ].join("\n");
+
+  const diffHunks = [
+    "@@ -3,3 +3,3 @@",
+    " * Some context comment",
+    "+ * validateAccess(user);",
+    " * Other comment"
+  ].join("\n");
+
+  const candidates = extractCandidateCallSymbols(diffHunks, { fileContent });
+  assert.equal(candidates.length, 0, "Commented-out call inside hunk must not be extracted as candidate call");
+});
+
+test("SYSTEMIC-C01-HUNK-LEXICAL-STATE (Negative without fileContent): Emits lexicalStateUncertain when fileContent is absent", () => {
+  const diffHunks = [
+    "@@ -150,4 +150,4 @@",
+    " contextLine();",
+    "+validateAccess(user);",
+    " trailingContext();"
+  ].join("\n");
+
+  const candidates = extractCandidateCallSymbols(diffHunks);
+  const valCall = candidates.find(c => c.symbol === "validateAccess");
+  assert.ok(valCall, "Should extract validateAccess candidate");
+  assert.equal(valCall.lexicalStateUncertain, true, "Must flag lexicalStateUncertain when fileContent is absent at line > 1");
+});
+
+test("SYSTEMIC-C01-HUNK-LEXICAL-STATE (Positive): Hunk in regular executable code accurately extracts candidate calls", () => {
+  const fileContent = [
+    "function init() {",
+    "  const x = 1;",
+    "}"
+  ].join("\n");
+
+  const diffHunks = [
+    "@@ -1,3 +1,4 @@",
+    " function init() {",
+    "+  validateAccess(user);",
+    "   const x = 1;",
+    " }"
+  ].join("\n");
+
+  const candidates = extractCandidateCallSymbols(diffHunks, { fileContent });
+  assert.equal(candidates.length, 1);
+  assert.equal(candidates[0].symbol, "validateAccess");
+  assert.equal(candidates[0].lexicalStateUncertain, false);
+});
