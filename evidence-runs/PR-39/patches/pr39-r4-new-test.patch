+    diffHunks: "diff --git a/src/a.mjs b/src/a.mjs\n@@ -1 +1 @@\n+x\ndiff --git a/src/b.mjs b/src/b.mjs\n@@ -1 +1 @@\n+y"
+  };
+
+  const multiPkg = buildContextPackage(changeSet, "multi-file");
