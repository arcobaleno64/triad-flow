+// ============================================================================
+// Cluster C14C: Sentry Complete File Coverage Requirement (rvCBW)
+// ============================================================================
+
+test("SYSTEMIC-C14C-SENTRY-COVERAGE-INCOMPLETE-GATE-BLOCK (Negative): Sentry reporting omitted files blocks Clean Approval", () => {
+  const consensus = aggregateConsensus({
+    agy: { provider: "agy", executionStatus: "success", fileCoverageComplete: true, findings: [{ ruleId: "TEST-1", severity: "medium", title: "Test finding" }] },
+    claude: { provider: "claude", executionStatus: "success", fileCoverageComplete: true, findings: [{ ruleId: "TEST-1", severity: "medium", title: "Test finding" }] },
+    codex: { provider: "codex", executionStatus: "success", fileCoverageComplete: true, findings: [{ ruleId: "TEST-1", severity: "medium", title: "Test finding" }] }
+  }, { policy: "TRI_PARTY_HETEROGENEOUS", tier: 1 });
+
+  const gate = evaluateGateDecision(consensus, {
+    tier: 1,
+    strict: true,
+    contextGaps: [
+      {
+        code: "INSUFFICIENT_PRODUCER_COVERAGE",
+        symbol: "sentry-coverage",
+        reason: "Sentry codex reported omittedFiles: ['src/security.mjs']",
+        category: "security"
+      }
+    ]
+  });
+
+  assert.equal(gate.decision, "block", "Incomplete sentry file coverage must block Clean Approval");
+  assert.ok(gate.reason.includes("INSUFFICIENT_PRODUCER_COVERAGE") || gate.reason.includes("context gap"));
+});
+
+test("SYSTEMIC-C14C-SENTRY-COVERAGE-COMPLETE (Positive): Complete sentry coverage without omissions permits Clean Approval", () => {
+  const consensus = aggregateConsensus({
+    agy: { provider: "agy", executionStatus: "success", fileCoverageComplete: true, findings: [] },
+    claude: { provider: "claude", executionStatus: "success", fileCoverageComplete: true, findings: [] },
+    codex: { provider: "codex", executionStatus: "success", fileCoverageComplete: true, findings: [] }
+  }, { policy: "TRI_PARTY_HETEROGENEOUS", tier: 2 });
+
+  const gate = evaluateGateDecision(consensus, {
+    tier: 2,
+    preliminary: true,
+    contextGaps: []
+  });
+
+  assert.equal(gate.decision, "approve", "Complete coverage without omissions permits Clean Approval");
+});
