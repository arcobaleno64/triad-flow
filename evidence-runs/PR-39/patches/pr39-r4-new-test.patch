+// Cluster C05: Division Chain vs Regex Literal Distinction (r1BuI)
+// ============================================================================
+
+test("SYSTEMIC-C05-DIVISION-CHAIN-PRESERVATION (Negative): Chained division operands are not swallowed as regex literals", () => {
+  const expr1 = "const res = total / parseLimit(input) / scale;";
+  const stripped1 = stripCommentsAndStrings(expr1);
+  assert.ok(stripped1.includes("parseLimit(input)"), "parseLimit must not be stripped");
+  assert.ok(stripped1.includes("scale"), "scale must not be stripped");
+
+  const expr2 = "const val = items[idx] / getDivisor(key) / factor;";
+  const stripped2 = stripCommentsAndStrings(expr2);
+  assert.ok(stripped2.includes("getDivisor(key)"), "getDivisor must not be stripped");
+  assert.ok(stripped2.includes("factor"), "factor must not be stripped");
+});
+
+test("SYSTEMIC-C05-DIVISION-CHAIN-PRESERVATION (Positive): True regex literals are correctly stripped", () => {
+  const expr = "const isMatch = /^[a-z]+$/g.test(input);";
+  const stripped = stripCommentsAndStrings(expr);
+  assert.ok(!stripped.includes("^[a-z]+$"), "Regex pattern content must be stripped");
+  assert.ok(stripped.includes(".test(input)"), "Method invocation after regex must be preserved");
+});
