+  assert.equal(singlePkg.targetFile, "src/a.mjs");
+  const rawHunks = singlePkg.layers?.layer0Diff?.rawHunks || "";
+  assert.equal(rawHunks, "", "Missing target file in structured diff must yield empty rawHunks, rejecting fallback to b.mjs diff");
+  const gap = singlePkg.contextGaps?.find(g => g.code === "DIFF_TARGET_FILE_NOT_FOUND");
+  assert.ok(gap, "Must emit DIFF_TARGET_FILE_NOT_FOUND context gap when target file is missing from structured diff");
+});
