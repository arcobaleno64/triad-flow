+
+  const defs = findFunctionDefinitions(lines, "validateAccess");
+  assert.equal(defs.length, 0, "findFunctionDefinitions must ignore definitions within block comments");
+});
+
+test("SYSTEMIC-C02-COMMENTED-DEF-EXCLUSION (Positive): Legitimate function preceded by comments is accurately found with line numbers preserved", () => {
+  const lines = [
+    "/* Header comment */",
+    "// Single line note",
+    "function validateAccess(user) {",
+    "  return user.isAdmin;",
+    "}"
+  ];
