    "bench:real:live": "node bin/triad-flow.mjs benchmark --live",
    "doctor": "node bin/triad-flow.mjs doctor",
    "demo": "node bin/triad-flow.mjs demo",
    "review": "node bin/triad-flow.mjs review",
    "factory": "node bin/triad-flow.mjs factory",
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "manifest:generate": "node scripts/generate-manifest-bundle.mjs",
    "manifest:verify": "node scripts/verify-artifact-manifest.mjs",
    "sbom:generate": "npm sbom --sbom-format=spdx",
    "evidence:0002": "node scripts/assemble-evidence-0002.mjs",
    "evidence:0003": "node scripts/assemble-evidence-0003.mjs",
    "evidence:0004": "node scripts/assemble-evidence-0004.mjs",
