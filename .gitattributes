# The npm `bin` entry point is exec'd via its shebang line. Force LF so a Windows
# checkout (core.autocrlf=true) does not publish a CRLF shebang that fails to exec
# on Linux/macOS ("/usr/bin/env: 'node\r': No such file or directory").
*.mjs text eol=lf

# JSON consumers (npm, SARIF readers) are not uniformly CR-tolerant.
*.json text eol=lf

# GitHub Actions `run: |` blocks are fed to bash. A CRLF there becomes a stray
# carriage return in the script and breaks the step.
*.yml text eol=lf
